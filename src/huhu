export function addpj(){   
    const projectss = [];

    function Pjtitle(project){
        this.project = project;
        console.log(project);
    }

    function addproject(projectadd){
        projectss.push(projectadd)
        showproject();
    }

    function showproject(){
        const displays = document.getElementById("centerpage");
        displays.innerHTML = "";
        projectss.forEach((projectadd, index) => {
    
            const frame = document.createElement("div");
            frame.classList.add("projectwindow");
            frame.setAttribute("data-index", index);
            frame.innerHTML = `<p>Title: ${projectadd.project} </p>`;   
                
        displays.innerHTML = frame.innerHTML;
        })
    }

    document.getElementById("project-dialog").showModal();

    document.getElementById("ps1").addEventListener("click", (e) => {
        e.preventDefault();

        const project = document.getElementById("pjtitle").value;
        projectss.push(project);
        const newproject = new Pjtitle(project);
        addproject(newproject);       
    })

}
